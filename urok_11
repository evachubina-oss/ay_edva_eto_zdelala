import cv2
from PIL import Image

image_path = "photo.jpg"
mask_path = "mask.png"

cv_image = cv2.imread(image_path)
if cv_image is None:
    raise FileNotFoundError(f"Не знайдено файл '{image_path}'")

gray = cv2.cvtColor(cv_image, cv2.COLOR_BGR2GRAY)

cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_smile.xml"
)

patterns = cascade.detectMultiScale(
    gray, scaleFactor=1.7, minNeighbors=20, minSize=(25, 25)
)
print(f"Знайдено патернів: {len(patterns)}")

base_img = Image.open(image_path).convert("RGBA")
mask_img = Image.open(mask_path).convert("RGBA")

for x, y, w, h in patterns:
    resized_mask = mask_img.resize((w, h))
    base_img.paste(resized_mask, (x, y), resized_mask)

base_img.convert("RGB").save("result.jpg")
base_img.show()
