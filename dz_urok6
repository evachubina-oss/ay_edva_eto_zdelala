result = []

def divider(a, b):
    if a < b:
        raise ValueError("Число a менше за b")
    if b > 100:
        raise IndexError("Число b більше за 100")
    return a / b

data = {10: 2, 2: 5, "123": 4, 18: 0, (1, 2): 15, 8: 4}

for key in data:
    try:
        res = divider(key, data[key])
        result.append(res)
    except Exception as e:
        print(f"Виявлено виняток: {type(e).__name__} — {e}")

print("\nУспішно оброблені результати:")
print(result)
