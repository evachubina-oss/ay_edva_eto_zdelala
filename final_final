def fight():
    try:
        p1 = service.get_pokemon(entry1.get())
        p2 = service.get_pokemon(entry2.get())
        if p1.power() > p2.power():
            winner = f"Победил {p1.name}! ({p1.power()} против {p2.power()})"
        elif p2.power() > p1.power():
            winner = f"Победил {p2.name}! ({p2.power()} против {p1.power()})"
        else:
            winner = "Ничья!"
        result_label.config(text=f"{p1.name} vs {p2.name}\n\n{winner}")
    except ValueError as e:
        messagebox.showwarning("Внимание", str(e))
    except requests.RequestException:
        messagebox.showerror("Ошибка", "Нет подключения к интернету")


