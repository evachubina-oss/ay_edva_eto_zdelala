import tkinter as tk
from tkinter import messagebox
import requests


class Pokemon:
    def __init__(self, name, poke_type, hp, attack, defense, speed):
        self.name = name
        self.poke_type = poke_type
        self.hp = hp
        self.attack = attack
        self.defense = defense
        self.speed = speed

    def power(self):
        return self.hp + self.attack + self.defense + self.speed

    def __str__(self):
        return (
            f"Имя: {self.name}\n"
            f"Тип: {self.poke_type}\n"
            f"HP: {self.hp}, Атака: {self.attack}, Защита: {self.defense}, Скорость: {self.speed}\n"
            f"Общая сила: {self.power()}"
        )


class PokeService:
    URL = "https://pokeapi.co/api/v2/pokemon/"

    def get_pokemon(self, name):
        if name == "":
            raise ValueError("Ты ничего не ввел. О чём ты думал(а)?")

        response = requests.get(self.URL + name, timeout=15)
        if response.status_code == 404:
            raise ValueError("Ты головой по клавиатуре бился? Пишешь с маленькой буквы и БЕЗ пробелов. Следи за этим...")
        response.raise_for_status()

        data = response.json()
        first_type = data["types"].pop(0)
        poke_type = first_type["type"]["name"]

        stats = {}
        for item in data["stats"]:
            stats[item["stat"]["name"]] = item["base_stat"]

        return Pokemon(
            name=data["name"],
            poke_type=poke_type,
            hp=stats["hp"],
            attack=stats["attack"],
            defense=stats["defense"],
            speed=stats["speed"],
        )

    def get_pokemon_list(self):
        response = requests.get(self.URL + "?limit=20", timeout=15)
        response.raise_for_status()
        data = response.json()

        names = []
        for item in data["results"]:
            names.append(item["name"])
        return names


